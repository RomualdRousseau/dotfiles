{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#200e1890",
                "editor.background": "#200e1890",
                "editor.foreground": "#c7c2c5",
                "text": "#c7c2c5",
                "text.muted": "#c7c2c570",
                "text.ignored": "#c7c2c540",
                "text.placeholder": "#c7c2c550",
                "ignored": "#c7c2c530",
                "element.hover": "#c7c2c530",
                "ghost_element.hover": "#903de730",
                "ghost_element.selected": "#903de730",
                "ghost_element.active": "#903de760",
                "border": "#200e18",
                "editor.highlighted_line.background": "#903de710",
                "editor.active_line.background": "#903de710",
                "panel.background": "#200e1890",
                "title_bar.background": "#200e1890",
                "title_bar.inactive_background": "#200e1890",
                "status_bar.background": "#200e1890",
                "drop_target.background": "#200e1890",
                "elevated_surface.background": "#200e18",
                "toolbar.background": "#200e1890",
                "tab_bar.background": "#200e1890",
                "tab.inactive_background": "#200e1890",
                "tab.active_background": "#903de730",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#200e18",
                "scrollbar.thumb.background": "#903de7",
                "editor.gutter.background": "#200e1890",
                "terminal.background": "#200e1810",
                "terminal.foreground": "#c7c2c5",
                "terminal.dim_foreground": "#c7c2c5",
                "terminal.bright_foreground": "#c7c2c5",
                "terminal.ansi.black": "#200e18",
                "terminal.ansi.red": "#903de7",
                "terminal.ansi.green": "#854ed1",
                "terminal.ansi.yellow": "#875b9b",
                "terminal.ansi.blue": "#9f3ad2",
                "terminal.ansi.magenta": "#8f52b1",
                "terminal.ansi.cyan": "#219c8d",
                "terminal.ansi.white": "#9b9097",
                "terminal.ansi.bright_black": "#7d6671",
                "terminal.ansi.bright_red": "#903ee7",
                "terminal.ansi.bright_green": "#854fd1",
                "terminal.ansi.bright_yellow": "#9766AD",
                "terminal.ansi.bright_blue": "#9f3ad2",
                "terminal.ansi.bright_magenta": "#A860D1",
                "terminal.ansi.bright_cyan": "#2DD1BD",
                "terminal.ansi.bright_white": "#c7c2c5",
                "modified": "#903de7",
                "syntax": {
                    "attribute": {
                        "color": "#903de7"
                    },
                    "boolean": {
                      "color": "#854ed1"
                    },
                    "comment": {
                      "color": "#7d6671"
                    },
                    "comment.doc": {
                      "color": "#7d6671"
                    },
                    "constant": {
                      "color": "#854fd1"
                    },
                    "function": {
                      "color": "#2DD1BD"
                    },
                    "keyword": {
                      "color": "#9f3ad2"
                    },
                    "number": {
                      "color": "#8f52b1"
                    },
                    "operator": {
                      "color": "#9f3ad2"
                    },
                    "string": {
                      "color": "#903de7"
                    },
                    "variable": {
                      "color": "#854ed1"
                    }
                },
                "players": [
                  {
                    "cursor": "#903de7",
                    "background": "#200e18",
                    "selection": "#903de730"
                  }
                ]
            }
        }
    ]
}
