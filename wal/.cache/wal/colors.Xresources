! X colors.
! Generated by 'wal'
*foreground:        #d9cbd1
*background:        #150c11
*.foreground:       #d9cbd1
*.background:       #150c11
emacs*foreground:   #d9cbd1
emacs*background:   #150c11
URxvt*foreground:   #d9cbd1
XTerm*foreground:   #d9cbd1
UXTerm*foreground:  #d9cbd1
URxvt*background:   [100]#150c11
XTerm*background:   #150c11
UXTerm*background:  #150c11
URxvt*cursorColor:  #d9cbd1
XTerm*cursorColor:  #d9cbd1
UXTerm*cursorColor: #d9cbd1
URxvt*borderColor:  [100]#150c11

! Colors 0-15.
*.color0: #150c11
*color0:  #150c11
*.color1: #672CA5
*color1:  #672CA5
*.color2: #6D41AB
*color2:  #6D41AB
*.color3: #9766AD
*color3:  #9766AD
*.color4: #9537C5
*color4:  #9537C5
*.color5: #A860D1
*color5:  #A860D1
*.color6: #2DD1BD
*color6:  #2DD1BD
*.color7: #d9cbd1
*color7:  #d9cbd1
*.color8: #978e92
*color8:  #978e92
*.color9: #672CA5
*color9:  #672CA5
*.color10: #6D41AB
*color10:  #6D41AB
*.color11: #9766AD
*color11:  #9766AD
*.color12: #9537C5
*color12:  #9537C5
*.color13: #A860D1
*color13:  #A860D1
*.color14: #2DD1BD
*color14:  #2DD1BD
*.color15: #d9cbd1
*color15:  #d9cbd1

! Black color that will not be affected by bold highlighting.
*.color66: #150c11
*color66:  #150c11

! Xclock colors.
XClock*foreground: #d9cbd1
XClock*background: #150c11
XClock*majorColor:  rgba:d9/cb/d1/ff
XClock*minorColor:  rgba:d9/cb/d1/ff
XClock*hourColor:   rgba:d9/cb/d1/ff
XClock*minuteColor: rgba:d9/cb/d1/ff
XClock*secondColor: rgba:d9/cb/d1/ff

! Set depth to make transparency work.
URxvt*depth: 32

! dwm colors
dwm.normbordercolor: #978e92 
dwm.normbgcolor: #150c11
dwm.normfgcolor: #d9cbd1
dwm.selbordercolor: #d9cbd1 
dwm.selbgcolor: #6D41AB
dwm.selfgcolor: #d9cbd1 
