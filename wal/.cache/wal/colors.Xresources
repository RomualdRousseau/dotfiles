! X colors.
! Generated by 'wal'
*foreground:        #c7c2c5
*background:        #200e18
*.foreground:       #c7c2c5
*.background:       #200e18
emacs*foreground:   #c7c2c5
emacs*background:   #200e18
URxvt*foreground:   #c7c2c5
XTerm*foreground:   #c7c2c5
UXTerm*foreground:  #c7c2c5
URxvt*background:   [100]#200e18
XTerm*background:   #200e18
UXTerm*background:  #200e18
URxvt*cursorColor:  #c7c2c5
XTerm*cursorColor:  #c7c2c5
UXTerm*cursorColor: #c7c2c5
URxvt*borderColor:  [100]#200e18

! Colors 0-15.
*.color0: #200e18
*color0:  #200e18
*.color1: #903de7
*color1:  #903de7
*.color2: #854ed1
*color2:  #854ed1
*.color3: #875b9b
*color3:  #875b9b
*.color4: #9f3ad2
*color4:  #9f3ad2
*.color5: #8f52b1
*color5:  #8f52b1
*.color6: #219c8d
*color6:  #219c8d
*.color7: #9b9097
*color7:  #9b9097
*.color8: #7d6671
*color8:  #7d6671
*.color9: #903ee7
*color9:  #903ee7
*.color10: #854fd1
*color10:  #854fd1
*.color11: #9766AD
*color11:  #9766AD
*.color12: #9f3ad2
*color12:  #9f3ad2
*.color13: #A860D1
*color13:  #A860D1
*.color14: #2DD1BD
*color14:  #2DD1BD
*.color15: #c7c2c5
*color15:  #c7c2c5

! Black color that will not be affected by bold highlighting.
*.color66: #200e18
*color66:  #200e18

! Xclock colors.
XClock*foreground: #c7c2c5
XClock*background: #200e18
XClock*majorColor:  rgba:c7/c2/c5/ff
XClock*minorColor:  rgba:c7/c2/c5/ff
XClock*hourColor:   rgba:c7/c2/c5/ff
XClock*minuteColor: rgba:c7/c2/c5/ff
XClock*secondColor: rgba:c7/c2/c5/ff

! Set depth to make transparency work.
URxvt*depth: 32

! dwm colors
dwm.normbordercolor: #7d6671 
dwm.normbgcolor: #200e18
dwm.normfgcolor: #c7c2c5
dwm.selbordercolor: #c7c2c5 
dwm.selbgcolor: #854ed1
dwm.selfgcolor: #c7c2c5 
